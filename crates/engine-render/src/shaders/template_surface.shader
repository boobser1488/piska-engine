//! kind: surface
// Шейдер поверхности для 3D-материала. Назначьте его материалу (инспектор материала →
// Shader), а материал — объекту с MeshRenderer. Свет, тени и туман движок добавит сам.
// Справка: docs/api/shaders.md.
//
// Параметры объявляются строками `//! param` и появляются в инспекторе материала.
// Строка `///` над параметром — подсказка к нему.

/// Цвет, которым окрашивается поверхность.
//! param tint: color = (1.0, 0.85, 0.6, 1.0)
/// Сила окраски: 0 — как обычный материал, 1 — полностью цветом tint.
//! param strength: float = 0.5 [0, 1]

fn surface(in: SurfaceIn) -> Surface {
    // Что нарисовал бы обычный материал (текстура, цвет, карта нормалей…).
    var s = default_surface(in);
    // Смешиваем его цвет с нашим. Попробуйте: s.emissive = params.tint.rgb * 2.0;
    s.albedo = mix(s.albedo, params.tint.rgb, params.strength);
    return s;
}
