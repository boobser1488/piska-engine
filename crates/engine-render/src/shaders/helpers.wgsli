// Встроенные функции для своих шейдеров (`.shader`, docs/api/shaders.md): есть в шейдере
// любого вида. Приклеиваются движком перед кодом пользователя (shaders/mod.rs).

const PI: f32 = 3.14159265;
const TAU: f32 = 6.2831853;

// Псевдослучайное число 0..1 по точке (одинаковое для одинаковых точек).
fn hash(p: vec2<f32>) -> f32 {
    let q = fract(p * vec2<f32>(123.34, 456.21));
    let r = q + dot(q, q + 45.32);
    return fract(r.x * r.y);
}

fn hash3(p: vec3<f32>) -> f32 {
    return hash(p.xy + vec2<f32>(p.z * 17.13, p.z * 3.71));
}

// Плавный шум 0..1 (value noise): соседние точки дают близкие значения.
fn value_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = hash(i);
    let b = hash(i + vec2<f32>(1.0, 0.0));
    let c = hash(i + vec2<f32>(0.0, 1.0));
    let d = hash(i + vec2<f32>(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

// Шум из четырёх слоёв (крупные пятна + мелкие детали), 0..1.
fn fbm(p: vec2<f32>) -> f32 {
    var sum = 0.0;
    var amplitude = 0.5;
    var q = p;
    for (var i = 0; i < 4; i += 1) {
        sum += value_noise(q) * amplitude;
        q = q * 2.03 + vec2<f32>(1.7, 9.2);
        amplitude *= 0.5;
    }
    return sum / 0.9375;
}

// Перевести значение из диапазона [from_min, from_max] в [to_min, to_max].
fn remap(value: f32, from_min: f32, from_max: f32, to_min: f32, to_max: f32) -> f32 {
    let t = (value - from_min) / max(from_max - from_min, 1e-6);
    return mix(to_min, to_max, t);
}

// Френель: 0 — поверхность смотрит на камеру, 1 — видна «по касательной» (края).
fn fresnel(normal: vec3<f32>, view_dir: vec3<f32>, power: f32) -> f32 {
    return pow(1.0 - clamp(dot(normalize(normal), normalize(view_dir)), 0.0, 1.0), power);
}

// Повернуть UV на угол (радианы) вокруг точки `center`.
fn rotate_uv(uv: vec2<f32>, angle: f32, center: vec2<f32>) -> vec2<f32> {
    let s = sin(angle);
    let c = cos(angle);
    let p = uv - center;
    return vec2<f32>(p.x * c - p.y * s, p.x * s + p.y * c) + center;
}

// Яркость цвета (как её видит глаз).
fn luminance(color: vec3<f32>) -> f32 {
    return dot(color, vec3<f32>(0.2126, 0.7152, 0.0722));
}

// Цвет RGB → HSV (оттенок, насыщенность, яркость; всё 0..1) и обратно.
fn rgb_to_hsv(c: vec3<f32>) -> vec3<f32> {
    let k = vec4<f32>(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    let p = select(vec4<f32>(c.gb, k.xy), vec4<f32>(c.bg, k.wz), c.g < c.b);
    let q = select(vec4<f32>(p.xyw, c.r), vec4<f32>(c.r, p.yzx), p.x < c.r);
    let d = q.x - min(q.w, q.y);
    let e = 1.0e-10;
    return vec3<f32>(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

fn hsv_to_rgb(c: vec3<f32>) -> vec3<f32> {
    let p = abs(fract(vec3<f32>(c.x) + vec3<f32>(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return c.z * mix(vec3<f32>(1.0), clamp(p - 1.0, vec3<f32>(0.0), vec3<f32>(1.0)), c.y);
}
