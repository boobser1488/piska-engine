                (
                    name: "Platform B",
                    transform: (position: (3.0, 0.6, 0.0)),
                    components: [
                        (kind: "SpriteRenderer", fields: {
                            "color": Color(0.266, 0.156, 0.125, 1.0),
                            "size": Vec2(3.0, 0.4),
                        }),
                        (kind: "Collider2D", fields: { "size": Vec2(3.0, 0.4), "one_way": Bool(true) }),
                    ],
                ),
                (
                    name: "Platform C",
                    transform: (position: (7.5, 2.1, 0.0), rotation: (0.0, 0.0, -6.0)),
