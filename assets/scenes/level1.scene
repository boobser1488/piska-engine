                    "color": Color(0.153, 0.072, 0.053, 1.0),
                    "size": Vec2(40.0, 6.0),
                }),
                (kind: "Collider2D", fields: { "size": Vec2(40.0, 6.0) }),
            ],
            children: [
                (
                    name: "Grass",
                    transform: (position: (0.0, 2.9, 0.0)),
                    components: [
                        (kind: "SpriteRenderer", fields: {
                            "color": Color(0.05, 0.366, 0.074, 1.0),
                            "size": Vec2(40.0, 0.2),
