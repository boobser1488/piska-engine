// Уровень платформера. Формат: RON, дерево объектов.
// Узел либо описан целиком (components + children), либо ссылается на префаб
// (prefab: Some("…")) и хранит только отличия (overrides).
(
    name: "Level 1",
    objects: [
        (
            name: "Main Camera",
            tag: "MainCamera",
            transform: (position: (-5.0, -0.5, 0.0)),
            components: [
                (kind: "Camera", fields: {
                    "ortho_size": Float(5.5),
                    "clear_color": Color(0.209, 0.578, 0.768, 1.0),
                }),
                (kind: "CameraFollow", fields: {
                    "target_tag": Str("Player"),
                    "smoothing": Float(6.0),
                    "offset": Vec2(0.0, 1.5),
                }),
            ],
        ),
        (
            name: "Backdrop",
            children: [
                (
                    name: "Far Hills",
                    transform: (position: (2.0, -1.2, 0.0)),
                    components: [
                        (kind: "SpriteRenderer", fields: {
                            "color": Color(0.159, 0.451, 0.392, 1.0),
