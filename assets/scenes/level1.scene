            ],
        ),
        (
            name: "Platforms",
            children: [
                (
                    name: "Platform A",
                    transform: (position: (-1.5, -0.9, 0.0)),
                    components: [
                        (kind: "SpriteRenderer", fields: {
                            "color": Color(0.266, 0.156, 0.125, 1.0),
                            "size": Vec2(3.0, 0.4),
                        }),
                        (kind: "Collider2D", fields: { "size": Vec2(3.0, 0.4), "one_way": Bool(true) }),
