        (
            name: "Coins",
            children: [
                // Обычный экземпляр префаба: только имя и позиция.
                (
                    name: "Coin 1",
                    prefab: Some("prefabs/coin.prefab"),
                    transform: (position: (-4.0, -1.9, 0.0)),
