// Падающая звезда: картинка, физическое тело с лёгкой гравитацией, триггер и два готовых
// поведения: поймана корзиной — «Caught» объекту Game и звук; упала ниже края экрана —
// «Missed» объекту Game. В обоих случаях звезда исчезает.
(
    name: "Star",
    tag: "Star",
    components: [
        (kind: "SpriteRenderer", fields: {
            "texture": Asset("1a2b3c4d5e6f40718293a4b5c6d7e802"),
            "size": Vec2(0.9, 0.9),
            "order": Int(2),
        }),
        (kind: "Rigidbody2D", fields: {
            "body_type": Enum("Dynamic"),
            "gravity_scale": Float(0.25),
        }),
        (kind: "Collider2D", fields: {
            "shape": Enum("Circle"),
            "radius": Float(0.35),
            "is_trigger": Bool(true),
        }),
        (kind: "Collectible", fields: {
            "message": Str("Caught"),
            "notify": Str("Game"),
            "sound": Str("sounds/catch.wav"),
        }),
        // margin −0.4: звезда «упала», когда её центр на 0.4 выше нижнего края экрана —
        // там, где она уходит в траву.
        (kind: "OffScreen", fields: {
            "message": Str("Missed"),
            "notify": Str("Game"),
            "margin": Float(-0.4),
        }),
    ],
)
